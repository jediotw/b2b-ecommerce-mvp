# Local development environment for docker compose.
#
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# SECURITY: the values below are LOCAL-DEVELOPMENT-ONLY defaults and are not
# real secrets. Never reuse this password outside a local machine.

# Database created by the PostgreSQL container on first startup.
POSTGRES_DB=shop

# Database user created by the PostgreSQL container on first startup.
POSTGRES_USER=shop

# LOCAL-DEVELOPMENT-ONLY password (matches the default in compose.yaml).
POSTGRES_PASSWORD=localdev
